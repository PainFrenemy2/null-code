<Window x:Class="NullMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NullMonitor.Controls"
        Title="Null Monitor" Width="1120" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource Text}" Icon="Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- soft glow in the corner -->
        <Ellipse Width="700" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-250,-260,0,0" Opacity="0.35" IsHitTestVisible="False" Grid.RowSpan="3">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="#007C3AED" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="700" Height="500" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-300,-300" Opacity="0.18" IsHitTestVisible="False" Grid.RowSpan="3">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22D3EE" Offset="0"/>
                    <GradientStop Color="#0022D3EE" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ═════════ Title bar ═════════ -->
        <Grid Grid.Row="0" Margin="16,0,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="20" Height="20" Margin="0,0,10,0"/>
                <TextBlock Text="Null Monitor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="#1F7C3AED" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11" Foreground="#A78BFA"/>
                </Border>
                <TextBlock Text="by painfrenemy" FontSize="11" Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ClockText" FontSize="12" Foreground="{StaticResource SubText}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button x:Name="PinButton" Style="{StaticResource TitleButton}" Content="&#xE718;"
                        FontSize="13" ToolTip="Поверх всех окон" Click="Pin_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource TitleButton}" Content="&#xE921;" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="MaxButton" Style="{StaticResource TitleButton}" Content="&#xE922;" Click="Maximize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- ═════════ Dashboard ═════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="8,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CPU -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ПРОЦЕССОР" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="CpuName" Text="—" Style="{StaticResource HwName}"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="130" Height="130">
                                <c:RingGauge x:Name="CpuGauge" Thickness="12" FromColor="#7C3AED" ToColor="#22D3EE"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CpuLoadText" Text="—" Style="{StaticResource BigValue}"/>
                                    <TextBlock Text="нагрузка" Style="{StaticResource StatLabel}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Column="1" Columns="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Температура" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="CpuTempText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Частота" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="CpuClockText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Мощность" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="CpuPowerText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Потоки" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="CpuThreadsText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                        <TextBlock Text="Ядра" Style="{StaticResource StatLabel}" Margin="0,18,0,6"/>
                        <c:CoreBars x:Name="CpuCores" Height="46"/>
                        <DockPanel Margin="0,16,0,6">
                            <TextBlock Text="История · 60 с" Style="{StaticResource StatLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="#A78BFA" Margin="0,0,5,0"/>
                                <TextBlock Text="нагрузка" Style="{StaticResource StatLabel}" Margin="0,0,12,0"/>
                                <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,5,0"/>
                                <TextBlock Text="°C" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </DockPanel>
                        <c:Sparkline x:Name="CpuChart" Height="70" LineColor="#A78BFA" LineColor2="#F97316" Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- GPU -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ВИДЕОКАРТА" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="GpuName" Text="—" Style="{StaticResource HwName}"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="130" Height="130">
                                <c:RingGauge x:Name="GpuGauge" Thickness="12" FromColor="#22C55E" ToColor="#A3E635"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="GpuLoadText" Text="—" Style="{StaticResource BigValue}"/>
                                    <TextBlock Text="нагрузка" Style="{StaticResource StatLabel}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Column="1" Columns="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Температура" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="GpuTempText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Частота" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="GpuClockText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Мощность" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="GpuPowerText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="GpuExtraLabel" Text="Hot spot" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="GpuExtraText" Text="—" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                        <DockPanel Margin="0,18,0,6">
                            <TextBlock Text="Видеопамять" Style="{StaticResource StatLabel}"/>
                            <TextBlock x:Name="VramText" Text="—" Style="{StaticResource StatLabel}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Grid Height="10">
                            <Border Background="#1FFFFFFF" CornerRadius="5"/>
                            <Border x:Name="VramBar" CornerRadius="5" HorizontalAlignment="Left" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#22C55E" Offset="0"/>
                                        <GradientStop Color="#A3E635" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <DockPanel Margin="0,16,0,6">
                            <TextBlock Text="История · 60 с" Style="{StaticResource StatLabel}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,5,0"/>
                                <TextBlock Text="нагрузка" Style="{StaticResource StatLabel}" Margin="0,0,12,0"/>
                                <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,5,0"/>
                                <TextBlock Text="°C" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </DockPanel>
                        <c:Sparkline x:Name="GpuChart" Height="70" LineColor="#4ADE80" LineColor2="#F97316" Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="110" Height="110">
                                <c:RingGauge x:Name="RamGauge" Thickness="10" FromColor="#F97316" ToColor="#EC4899"/>
                                <TextBlock x:Name="RamLoadText" Text="—" FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="Занято" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="RamUsedText" Text="—" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Свободно" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="RamFreeText" Text="—" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Всего" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="RamTotalText" Text="—" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </UniformGrid>
                                <c:Sparkline x:Name="RamChart" Height="48" Margin="0,14,0,0"
                                             LineColor="#F472B6" Maximum="100"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Network -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="СЕТЬ" Style="{StaticResource CardTitle}"/>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" Foreground="#22D3EE"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Загрузка" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="NetDownText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" Foreground="#A78BFA"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Отдача" Style="{StaticResource StatLabel}"/>
                                </StackPanel>
                                <TextBlock x:Name="NetUpText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                        <c:Sparkline x:Name="NetChart" Height="64" Margin="0,14,0,0"
                                     LineColor="#22D3EE" LineColor2="#A78BFA" Maximum="0"/>
                    </StackPanel>
                </Border>

                <!-- Disks -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="НАКОПИТЕЛИ" Style="{StaticResource CardTitle}"/>
                        <StackPanel x:Name="DiskList" Margin="0,8,0,0"/>
                        <TextBlock x:Name="NoDisksText" Text="Нет данных" Style="{StaticResource StatLabel}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- System -->
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="СИСТЕМА" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="BoardName" Text="—" Style="{StaticResource HwName}"/>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Время работы" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Процессы" Style="{StaticResource StatLabel}"/>
                                <TextBlock x:Name="ProcText" Text="—" Style="{StaticResource StatValue}"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Вентиляторы" Style="{StaticResource StatLabel}" Margin="0,16,0,6"/>
                        <WrapPanel x:Name="FanList"/>
                        <TextBlock x:Name="NoFansText" Text="Датчики не найдены" Foreground="{StaticResource Dim}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ═════════ Status bar ═════════ -->
        <Border Grid.Row="2" Background="#0FFFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="16,7">
            <DockPanel>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Запуск датчиков…" FontSize="11" Foreground="{StaticResource SubText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
