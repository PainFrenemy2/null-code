<Window x:Class="NullMonitor.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Null Monitor Taskbar" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Width" Height="48" Left="-10000" Top="-10000"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold"
        TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
    <Border x:Name="Root" Background="#01000000" CornerRadius="6" Padding="8,0">
        <StackPanel x:Name="Columns" Orientation="Horizontal" VerticalAlignment="Center"/>
    </Border>
</Window>
